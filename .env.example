# Single-tenant credential (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load this. Do not add it to
# that service's environment or via env_file.
ABNORMAL_API_TOKEN=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When MCP_HTTP_HOST is unset, the
# server binds 127.0.0.1. The container image sets 0.0.0.0 and requires
# CONDUIT_S2S_SECRET. A configured secret honors this value. With no secret,
# MCP_ALLOW_INSECURE_DEV=1 forces 127.0.0.1 even if this is a wider address.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme,
# placeholder, your-s2s-secret, replace-with-a-real-secret, and similar
# example values), so a copied example cannot forge X-Gateway-S2S.
# Compose will not start when it is unset. Never commit a real value.
# The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST is ignored and the
# override is logged. A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (ABNORMAL_API_TOKEN) or gateway
# (Authorization: Bearer on each request; no env fallback). The container
# image and Compose service set gateway. Stdio ignores this and reads
# ABNORMAL_API_TOKEN.
# AUTH_MODE=env

# LOG_LEVEL=info
